---
import categoriesConfig from "@/config/categories.json";
import Base from "@/layouts/Base.astro";
import PostGrid from "@/components/PostGrid.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { getTaxonomy } from "@/lib/taxonomyParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { humanize, slugify } from "@/lib/utils/textConverter";
import taxonomyFilter from "@/lib/utils/taxonomyFilter";
import PageHeader from "@/partials/PageHeader.astro";

// get static paths for all categories: dynamic ones from post frontmatter,
// plus the fixed sidebar categories (even ones with 0 posts so far)
export async function getStaticPaths() {
  const BLOG_FOLDER = "blog";
  const categoriesFromPosts = await getTaxonomy(BLOG_FOLDER, "categories");
  const fixedCategorySlugs = categoriesConfig.list.map(({ label }) =>
    slugify(label),
  );
  const categories = [
    ...new Set([...categoriesFromPosts, ...fixedCategorySlugs]),
  ];

  return categories.map((category) => {
    return {
      params: { category },
    };
  });
}

const { category } = Astro.params;

const slugToLabel = Object.fromEntries(
  categoriesConfig.list.map(({ label }) => [slugify(label), label]),
);
const displayLabel = slugToLabel[category!] ?? humanize(category!);

// get posts by category
const BLOG_FOLDER = "blog";
const posts = await getSinglePage(BLOG_FOLDER);
const filterByCategories = taxonomyFilter(posts, "categories", category!);
const sortedPosts = sortByDate(filterByCategories);
---

<Base title={displayLabel}>
  <PageHeader title={displayLabel} />
  <div class="section-sm pb-0">
    <div class="container">
      {
        sortedPosts.length === 0 ? (
          <p class="pb-14 text-center text-text-light dark:text-darkmode-text-light">
            아직 글이 없습니다.
          </p>
        ) : (
          <PostGrid posts={sortedPosts} />
        )
      }
    </div>
  </div>
</Base>
