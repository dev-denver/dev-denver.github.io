---
import categoriesConfig from "@/config/categories.json";
import PostListPage from "@/layouts/PostListPage.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { getTaxonomy } from "@/lib/taxonomyParser.astro";
import { extraPageParams, pageFromParam } from "@/lib/utils/paginate";
import { sortByDate } from "@/lib/utils/sortFunctions";
import taxonomyFilter from "@/lib/utils/taxonomyFilter";
import { humanize, slugify } from "@/lib/utils/textConverter";

export async function getStaticPaths() {
  const posts = await getSinglePage("blog");
  // Mirrors categories/[category].astro: only categories with posts.
  const categories = await getTaxonomy("blog", "categories");

  return categories.flatMap((category) => {
    const count = taxonomyFilter(posts, "categories", category).length;
    return extraPageParams(count).map((slug) => ({
      params: { category, slug },
    }));
  });
}

const { category } = Astro.params;

const slugToLabel = Object.fromEntries(
  categoriesConfig.list.map(({ label }) => [slugify(label), label]),
);
const displayLabel = slugToLabel[category!] ?? humanize(category!);

const posts = await getSinglePage("blog");
const sortedPosts = sortByDate(taxonomyFilter(posts, "categories", category!));
---

<PostListPage
  title={displayLabel}
  humanizeTitle={false}
  description={`${displayLabel} 카테고리의 글 목록`}
  posts={sortedPosts}
  section={`categories/${category}`}
  currentPage={pageFromParam(Astro.params.slug)}
/>
