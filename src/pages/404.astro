---
import Base from "@/layouts/Base.astro";
---

<Base title="페이지를 찾을 수 없음" noindex>
  <section class="section-sm text-center">
    <div class="container">
      <div class="row justify-center">
        <div class="sm:col-10 md:col-8 lg:col-6">
          <span
            class="text-[8rem] block font-bold text-text-dark dark:text-darkmode-text-dark"
          >
            404
          </span>
          <h1 class="h2 mb-4">페이지를 찾을 수 없습니다</h1>
          <div class="content">
            <p>
              찾으시는 페이지가 삭제되었거나, 주소가 변경되었거나, 일시적으로
              이용할 수 없는 상태입니다.
            </p>
          </div>
          <div class="mt-8 flex flex-wrap justify-center gap-3">
            <a href="/" class="btn btn-primary">홈으로 돌아가기</a>
            <a href="/blog" class="btn btn-outline-primary">전체 글 보기</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
