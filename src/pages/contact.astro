---
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import PageHeader from "@/partials/PageHeader.astro";

const contactIndex = await getListPage("contact", "-index");
const { contact_form_action }: { contact_form_action: string } = config.params;
const { title, description, meta_title, image } = contactIndex.data;

const buildDrafts = process.argv.includes("--buildDrafts");
if (!buildDrafts && contactIndex.data.draft) {
  return Astro.redirect("/404");
}
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
>
  <PageHeader title={title} />
  <section class="section-sm">
    <div class="container">
      <div class="row">
        <div class="mx-auto md:col-10 lg:col-6">
          <form id="contact-form" action={contact_form_action} method="POST">
            <div class="mb-6">
              <label for="name" class="form-label">
                이름 <span class="text-red-500">*</span>
              </label>
              <input
                id="name"
                name="name"
                class="form-input"
                placeholder="홍길동"
                type="text"
                required
              />
            </div>
            <div class="mb-6">
              <label for="email" class="form-label">
                이메일 <span class="text-red-500">*</span>
              </label>
              <input
                id="email"
                name="email"
                class="form-input"
                placeholder="example@email.com"
                type="email"
                required
              />
            </div>
            <div class="mb-6">
              <label for="message" class="form-label">
                하고 싶은 말 <span class="text-red-500">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                class="form-input"
                placeholder="내용을 입력해주세요..."
                required
                rows="8"></textarea>
            </div>
            <button type="submit" class="btn btn-primary">보내기</button>
            <p
              id="contact-form-status"
              class="mt-4 hidden text-sm"
              role="status"
              aria-live="polite"
            >
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ contact_form_action }}>
  const form = document.getElementById("contact-form");
  const status = document.getElementById("contact-form-status");

  if (form && status && !contact_form_action.startsWith("http")) {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      status.textContent =
        "아직 폼 전송이 연결되어 있지 않아요. github.com/dev-denver 로 남겨주시면 확인할게요.";
      status.classList.remove("hidden");
      status.classList.add("text-red-500");
    });
  }
</script>
