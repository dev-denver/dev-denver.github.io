---
import BlogCard from "@/components/BlogCard.astro";
import HeadingAnchors from "@/components/HeadingAnchors.astro";
import PostNav from "@/components/PostNav.astro";
import Share from "@/components/Share.astro";
import Toc from "@/components/Toc.astro";
import TocScrollSpy from "@/components/TocScrollSpy.astro";
import Giscus from "@/helpers/Giscus.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import readingTime from "@/lib/utils/readingTime";
import similarItems from "@/lib/utils/similarItems";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { humanize, markdownify, slugify } from "@/lib/utils/textConverter";
import { render } from "astro:content";
import { FaRegClock, FaRegFolder, FaRegUserCircle } from "react-icons/fa";
import ImageMod from "./components/ImageMod.astro";

const COLLECTION_FOLDER = "blog";
const { post } = Astro.props;

const posts = await getSinglePage(COLLECTION_FOLDER);
const similarPosts = similarItems(post, posts);
const { Content, headings } = await render(post);
const { title, description, author, categories, image, date, tags } = post.data;

// Newest first, so the entry after this one in the list is the older post.
const sortedPosts = sortByDate(posts);
const currentIndex = sortedPosts.findIndex(({ id }) => id === post.id);
const previousPost = sortedPosts[currentIndex + 1];
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : undefined;
---

<section class="section pt-7">
  <div class="container">
    <div class="row justify-center">
      {
        /* max-w caps the measure: `lg:col-8` alone runs ~880px on a wide
          screen, well past a comfortable line length for Korean body text.
          Applied to the whole column so the title and meta stay aligned with
          the body. */
      }
      <article class="lg:col-8 mx-auto max-w-[46rem]">
        {
          image && (
            <div class="mb-10">
              <ImageMod
                src={image}
                height={500}
                width={1200}
                alt={title}
                class="w-full rounded"
                format="webp"
              />
            </div>
          )
        }
        <h1 set:html={markdownify(title)} class="h2 mb-4" />
        <ul
          class="text-text-light dark:text-darkmode-text-light mb-10 text-sm [&_a:hover]:underline [&_a:hover]:underline-offset-2"
        >
          <li class="mr-4 inline-block">
            <a href={`/authors/${slugify(author)}`}>
              <FaRegUserCircle className={"mr-2 -mt-1 inline-block"} />
              {author}
            </a>
          </li>
          <li class="mr-4 inline-block">
            <FaRegFolder className={"mr-2 -mt-1 inline-block"} />
            {
              categories.map((category: string, index: number) => (
                <a href={`/categories/${slugify(category)}`}>
                  {humanize(category)}
                  {index !== categories.length - 1 && ","}
                </a>
              ))
            }
          </li>
          <li class="mr-4 inline-block">
            <FaRegClock className={"mr-2 -mt-1 inline-block"} />
            {dateFormat(date)}
          </li>
          <li class="inline-block">{readingTime(post.body ?? "")}</li>
        </ul>
        <Toc headings={headings} variant="inline" class="xl:hidden" />
        <div class="content mb-10">
          <Content />
        </div>
        <div class="row items-start justify-between">
          {
            /* Inline labels, not headings: these sat at h5 under the post
              title while the body used h2/h3, so they broke the outline. */
          }
          <div class="mb-10 flex items-center lg:col-5 lg:mb-0">
            <p
              id="post-tags-label"
              class="text-text-light dark:text-darkmode-text-light mr-3 text-sm"
            >
              태그
            </p>
            <ul aria-labelledby="post-tags-label" class="flex flex-wrap gap-2">
              {
                tags.map((tag: string) => (
                  <li>
                    <a class="tag-chip" href={`/tags/${slugify(tag)}`}>
                      {tag}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="flex items-center lg:col-4">
            <p
              class="text-text-light dark:text-darkmode-text-light mr-3 text-sm"
            >
              공유
            </p>
            <Share
              className="social-icons"
              title={title}
              description={description}
              slug={post.id}
            />
          </div>
        </div>
        <PostNav previous={previousPost} next={nextPost} />
        <Giscus className="mt-20" />
      </article>

      <aside class="xl:col-3 hidden xl:block">
        <Toc headings={headings} variant="rail" />
      </aside>
    </div>
    <TocScrollSpy />
    <HeadingAnchors />

    {
      similarPosts.length > 0 && (
        <div class="section pb-0">
          <div class="mx-auto max-w-[46rem]">
            <h2 class="text-h4 mb-6">관련 글</h2>
            <ul class="divide-border dark:divide-darkmode-border divide-y">
              {similarPosts.map((post) => (
                <li class="py-6 first:pt-0">
                  <BlogCard data={post} />
                </li>
              ))}
            </ul>
          </div>
        </div>
      )
    }
  </div>
</section>
