---
import Logo from "@/components/Logo.astro";
import Social from "@/components/Social.astro";
import ThemeSwitcher from "@/components/ThemeSwitcher.astro";
import categoriesConfig from "@/config/categories.json";
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import social from "@/config/social.json";
import { getAllTaxonomy } from "@/lib/taxonomyParser.astro";
import { slugify } from "@/lib/utils/textConverter";
import { IoSearch } from "react-icons/io5";

export interface NavigationLink {
  name: string;
  url: string;
}

const { main }: { main: NavigationLink[] } = menu;
const { navigation_button, settings } = config;
const { pathname } = Astro.url;

const BLOG_FOLDER = "blog";
const allCategorySlugs = await getAllTaxonomy(BLOG_FOLDER, "categories");
const categoryItems = categoriesConfig.list.map(({ label }) => {
  const slug = slugify(label);
  const count = allCategorySlugs.filter((c) => c === slug).length;
  return { label, slug, count };
});
---

<input type="checkbox" id="sidebar-toggle" class="hidden" />

<!-- mobile top bar -->
<div class="mobile-topbar">
  <Logo />
  <label
    for="sidebar-toggle"
    class="cursor-pointer -m-2.5 p-2.5"
    aria-label="메뉴 열기"
  >
    <svg
      id="sidebar-show-icon"
      class="h-6 fill-current block"
      viewBox="0 0 20 20"
    >
      <title>메뉴 열기</title>
      <path d="M0 3h20v2H0V3z m0 6h20v2H0V9z m0 6h20v2H0V0z"></path>
    </svg>
    <svg
      id="sidebar-hide-icon"
      class="h-6 fill-current hidden"
      viewBox="0 0 20 20"
    >
      <title>메뉴 닫기</title>
      <polygon
        points="11 9 22 9 22 11 11 11 11 22 9 22 9 11 -2 11 -2 9 9 9 9 -2 11 -2"
        transform="rotate(45 10 10)"></polygon>
    </svg>
  </label>
</div>

<!-- overlay: clicking it closes the drawer -->
<label
  for="sidebar-toggle"
  id="sidebar-overlay"
  class="hidden fixed inset-0 z-40 bg-black/50 lg:hidden"
  aria-hidden="true"></label>

<aside id="sidebar" class="sidebar">
  <div class="mb-8 hidden lg:block">
    <Logo />
  </div>

  <nav class="mb-8" aria-label="주요 메뉴">
    <ul class="space-y-1">
      {
        main.map((item) => {
          const isActive = pathname === `${item.url}/` || pathname === item.url;
          return (
            <li>
              <a
                href={item.url}
                class={`sidebar-link block ${isActive ? "active" : ""}`}
                aria-current={isActive ? "page" : undefined}
              >
                {item.name}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

  {
    /* A section label, not a document heading: the sidebar precedes main, so
      a heading here would land above the page's own top-level heading. The
      list is named through aria-labelledby instead. */
  }
  <nav class="mb-8" aria-labelledby="sidebar-categories-label">
    <p
      id="sidebar-categories-label"
      class="mb-4 text-sm font-semibold uppercase text-text-light dark:text-darkmode-text-light"
    >
      카테고리
    </p>
    <ul class="space-y-1">
      {
        categoryItems.map(({ label, slug, count }) => {
          const url = `/categories/${slug}`;
          const isActive = pathname === url || pathname === `${url}/`;
          return count > 0 ? (
            <li>
              <a
                href={url}
                class={`sidebar-category-link ${isActive ? "active" : ""}`}
                aria-current={isActive ? "page" : undefined}
              >
                <span>{label}</span>
                <span class="sidebar-category-count">{count}</span>
              </a>
            </li>
          ) : (
            <li>
              <span
                class="sidebar-category-link pointer-events-none opacity-50"
                aria-disabled="true"
              >
                <span>{label}</span>
                <span class="sidebar-category-count">{count}</span>
              </span>
            </li>
          );
        })
      }
    </ul>
  </nav>

  <div class="mt-auto pt-6">
    <Social source={social.main} className="social-icons mb-5" />
    <div class="flex items-center gap-5">
      {
        settings.search && (
          <button
            class="text-text dark:text-darkmode-text hover:bg-light hover:text-text-dark dark:hover:bg-darkmode-light dark:hover:text-darkmode-text-dark rounded p-2.5 text-xl transition"
            aria-label="검색"
            data-search-trigger
          >
            <IoSearch />
          </button>
        )
      }
      <ThemeSwitcher />
      {
        navigation_button.enable && (
          <a
            class="btn btn-outline-primary btn-sm"
            href={navigation_button.link}
            target={
              navigation_button.link.startsWith("http") ? "_blank" : "_self"
            }
            rel={navigation_button.link.startsWith("http") ? "noopener" : ""}
          >
            {navigation_button.label}
          </a>
        )
      }
    </div>
  </div>
</aside>
