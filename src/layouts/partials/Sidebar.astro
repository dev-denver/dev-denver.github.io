---
import Logo from "@/components/Logo.astro";
import ThemeSwitcher from "@/components/ThemeSwitcher.astro";
import categoriesConfig from "@/config/categories.json";
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import social from "@/config/social.json";
import { getAllTaxonomy } from "@/lib/taxonomyParser.astro";
import { slugify } from "@/lib/utils/textConverter";
import { IoSearch } from "react-icons/io5";

export interface NavigationLink {
  name: string;
  url: string;
}

const { main }: { main: NavigationLink[] } = menu;
const { navigation_button, settings } = config;
const { pathname } = Astro.url;

const BLOG_FOLDER = "blog";
const allCategorySlugs = await getAllTaxonomy(BLOG_FOLDER, "categories");
const categoryItems = categoriesConfig.list.map(({ label }) => {
  const slug = slugify(label);
  const count = allCategorySlugs.filter((c) => c === slug).length;
  return { label, slug, count };
});

// The resume, GitHub and Instagram links are all the same thing to a reader —
// somewhere else to go — so they render as one uniform list. They just live in
// two different config files: the resume is `navigation_button` (kept out of
// social.json, which also feeds the footer and the author card).
const outboundLinks = [
  ...(navigation_button.enable
    ? [{ label: "이력서", link: navigation_button.link }]
    : []),
  ...social.main.map(({ name, label, link }) => ({
    label: label ?? name,
    link,
  })),
];
---

<input type="checkbox" id="sidebar-toggle" class="hidden" />

<!-- mobile top bar -->
<div class="mobile-topbar">
  <Logo />
  <label
    for="sidebar-toggle"
    class="cursor-pointer -m-2.5 p-2.5"
    aria-label="메뉴 열기"
  >
    <svg
      id="sidebar-show-icon"
      class="h-6 fill-current block"
      viewBox="0 0 20 20"
    >
      <title>메뉴 열기</title>
      <path d="M0 3h20v2H0V3z m0 6h20v2H0V9z m0 6h20v2H0V0z"></path>
    </svg>
    <svg
      id="sidebar-hide-icon"
      class="h-6 fill-current hidden"
      viewBox="0 0 20 20"
    >
      <title>메뉴 닫기</title>
      <polygon
        points="11 9 22 9 22 11 11 11 11 22 9 22 9 11 -2 11 -2 9 9 9 9 -2 11 -2"
        transform="rotate(45 10 10)"></polygon>
    </svg>
  </label>
</div>

<!-- overlay: clicking it closes the drawer -->
<label
  for="sidebar-toggle"
  id="sidebar-overlay"
  class="hidden fixed inset-0 z-40 bg-black/50 lg:hidden"
  aria-hidden="true"></label>

<aside id="sidebar" class="sidebar" aria-label="사이트 탐색">
  <div class="mb-8 hidden lg:block">
    <Logo />
  </div>

  <nav class="mb-8" aria-label="주요 메뉴">
    <ul class="space-y-1">
      {
        main.map((item) => {
          const isActive = pathname === `${item.url}/` || pathname === item.url;
          return (
            <li>
              <a
                href={item.url}
                class={`sidebar-link block ${isActive ? "active" : ""}`}
                aria-current={isActive ? "page" : undefined}
              >
                {item.name}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

  {
    /* A section label, not a document heading: the sidebar precedes main, so
      a heading here would land above the page's own top-level heading. The
      list is named through aria-labelledby instead. */
  }
  <nav class="mb-8" aria-labelledby="sidebar-categories-label">
    <p id="sidebar-categories-label" class="sidebar-section-label">카테고리</p>
    <ul class="space-y-1">
      {
        categoryItems.map(({ label, slug, count }) => {
          const url = `/categories/${slug}`;
          const isActive = pathname === url || pathname === `${url}/`;
          return count > 0 ? (
            <li>
              <a
                href={url}
                class={`sidebar-category-link ${isActive ? "active" : ""}`}
                aria-current={isActive ? "page" : undefined}
              >
                <span>{label}</span>
                <span class="sidebar-category-count">{count}</span>
              </a>
            </li>
          ) : (
            <li>
              <span
                class="sidebar-category-link pointer-events-none opacity-50"
                aria-disabled="true"
              >
                <span>{label}</span>
                <span class="sidebar-category-count">{count}</span>
              </span>
            </li>
          );
        })
      }
    </ul>
  </nav>

  {
    /* Search was a bare icon at the bottom of the sidebar with no label and no
      hint that ⌘K opens it. A labelled control with the shortcut spelled out
      is the only thing that makes it discoverable. */
  }
  {
    settings.search && (
      <button class="search-trigger" data-search-trigger>
        <span class="flex items-center gap-2">
          <IoSearch />
          검색
        </span>
        <kbd class="search-trigger-kbd" data-search-shortcut>
          Ctrl K
        </kbd>
      </button>
    )
  }

  {
    /* The bottom zone used to invert the rail's hierarchy: two solid black
      36px social chips outweighed every nav link above them, and the resume
      link sat in the same row as the theme toggle, reading as a peer of a UI
      preference rather than as a destination. Links are now one quiet list
      shaped like the category list; the toggle is a separate settings row. */
  }
  <div class="mt-auto pt-8">
    <nav
      class="border-border dark:border-darkmode-border border-t pt-6"
      aria-labelledby="sidebar-links-label"
    >
      <p id="sidebar-links-label" class="sidebar-section-label">링크</p>
      <ul class="space-y-1">
        {
          outboundLinks.map(({ label, link }) => {
            const isExternal = link.startsWith("http");
            return (
              <li>
                <a
                  class="sidebar-outlink"
                  href={link}
                  target={isExternal ? "_blank" : "_self"}
                  rel={isExternal ? "noopener" : undefined}
                >
                  <span>{label}</span>
                  {isExternal && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M7 17 17 7M8 7h9v9" />
                    </svg>
                  )}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="border-border dark:border-darkmode-border mt-6 border-t pt-4">
      <div class="sidebar-setting-row">
        <span id="theme-switcher-label">테마 전환</span>
        <ThemeSwitcher labelledby="theme-switcher-label" />
      </div>
    </div>
  </div>
</aside>

<script>
  // The shortcut is ⌘K on macOS and Ctrl+K elsewhere. Rendered as "Ctrl K" so
  // the non-Mac majority needs no correction, then swapped on Apple platforms.
  function labelSearchShortcut() {
    if (!/Mac|iPhone|iPad/.test(navigator.platform)) return;
    document
      .querySelectorAll("[data-search-shortcut]")
      .forEach((element) => (element.textContent = "⌘ K"));
  }

  labelSearchShortcut();
  document.addEventListener("astro:page-load", labelSearchShortcut);
</script>
