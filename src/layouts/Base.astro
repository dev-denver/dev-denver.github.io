---
import CodeBlockCopy from "@/components/CodeBlockCopy.astro";
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Sidebar from "@/partials/Sidebar.astro";
import "@/styles/main.css";
import {
  GoogleTagmanager,
  GoogleTagmanagerNoscript,
} from "@digi4care/astro-google-tagmanager";
import { ClientRouter } from "astro:transitions";
import Announcement from "./helpers/Announcement";
import SearchModal from "./helpers/SearchModal";

// font families - build a Google Fonts CSS2 stylesheet URL from theme.json.
// Loaded via a plain <link> (not Astro's self-hosted Font API) because Noto
// Sans KR / IBM Plex Sans KR split into 100+ unicode-range files per weight
// to cover Hangul, and pre-fetching all of them at build time is unreliable.
// A <link> lets the browser fetch only the ranges a page actually uses.
const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);
const googleFontsHref = `https://fonts.googleapis.com/css2?${fontEntries
  .map(([, fontStr]) => `family=${fontStr}`)
  .join("&")}&display=swap`;

// types for frontmatters
export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  /** Share card, when the page has one generated for it. */
  ogImage?: string;
  /** "article" on blog posts, "website" everywhere else. */
  ogType?: "website" | "article";
  publishedTime?: Date;
  authorName?: string;
  tags?: string[];
}

// destructure frontmatter
const {
  title,
  meta_title,
  description,
  image,
  noindex,
  canonical,
  ogImage,
  ogType = "website",
  publishedTime,
  authorName,
  tags,
} = Astro.props;

const pageTitle = plainify(meta_title || title || config.site.title);
const pageDescription = plainify(
  description || config.metadata.meta_description,
);
// Every page gets a canonical URL. Previously the tag only rendered when a
// page passed `canonical`, and no page ever did — so it never appeared.
const canonicalUrl =
  canonical ?? new URL(Astro.url.pathname, config.site.base_url).href;
// A generated share card wins over post frontmatter, which in turn wins over
// the one shared fallback image.
const imageUrl = new URL(
  ogImage || image || config.metadata.meta_image,
  config.site.base_url,
).href;

const structuredData = {
  "@context": "https://schema.org",
  "@type": ogType === "article" ? "BlogPosting" : "WebSite",
  headline: pageTitle,
  name: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
  image: imageUrl,
  inLanguage: "ko-KR",
  ...(ogType === "article"
    ? {
        datePublished: publishedTime?.toISOString(),
        author: {
          "@type": "Person",
          name: authorName || config.metadata.meta_author,
        },
        keywords: tags?.join(", "),
        publisher: {
          "@type": "Organization",
          name: config.site.title,
        },
      }
    : {}),
};
---

<!doctype html>
<html lang="ko">
  <head>
    <!-- google tag manager -->
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanager id={config.google_tag_manager.gtm_id} />
      )
    }
    <!-- favicon -->
    <link rel="shortcut icon" href={config.site.favicon} />
    {/* RSS autodiscovery — lets a reader find the feed from the site URL. */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={config.site.title}
      href={new URL("rss.xml", config.site.base_url)}
    />
    <!-- theme meta -->
    <meta name="theme-name" content="astroplate" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    <!-- google font css -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {
      /* Loaded without blocking render. Measured at ~1.48s of render-blocking
        time, dominated by the third-party round trip rather than payload size.
        The stylesheet already uses display=swap, so text is painted in the
        fallback face either way — blocking only delayed everything else. */
    }
    <link rel="preload" as="style" href={googleFontsHref} />
    <link
      rel="stylesheet"
      href={googleFontsHref}
      media="print"
      onload="this.media='all'"
    />
    <noscript><link rel="stylesheet" href={googleFontsHref} /></noscript>

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- title -->
    <title>{pageTitle}</title>

    {
      /* No canonical on noindex pages — pointing search engines at a URL we
        are also telling them not to index is contradictory. */
    }
    {!noindex && <link rel="canonical" href={canonicalUrl} />}

    <!-- noindex robots -->
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- meta-description -->
    <meta name="description" content={pageDescription} />

    <ClientRouter />

    <!-- author from config.json -->
    <meta name="author" content={authorName || config.metadata.meta_author} />

    <!-- open graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={config.site.title} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={imageUrl} />

    {
      ogType === "article" && (
        <>
          {publishedTime && (
            <meta
              property="article:published_time"
              content={publishedTime.toISOString()}
            />
          )}
          <meta
            property="article:author"
            content={authorName || config.metadata.meta_author}
          />
          {tags?.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }

    <!-- twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- structured data -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body class="flex flex-col min-h-screen">
    {/* google tag manager noscript */}
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanagerNoscript id={config.google_tag_manager.gtm_id} />
      )
    }
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded focus:bg-primary focus:px-4 focus:py-2 focus:text-white dark:focus:bg-darkmode-primary dark:focus:text-text-dark"
    >
      본문 바로가기
    </a>
    <Announcement client:only="react" />
    <div class="flex flex-1 flex-col lg:flex-row">
      <Sidebar />
      <div class="flex min-w-0 flex-1 flex-col">
        <SearchModal client:only="react" />
        <main class="grow" id="main-content">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
    <TwSizeIndicator />
    <CodeBlockCopy />
  </body>
</html>
