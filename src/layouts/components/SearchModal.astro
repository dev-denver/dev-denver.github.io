---
// Site search. Previously a React island (`client:only`), which meant every
// page paid ~73KB gzip of React runtime and the modal markup did not exist
// until that runtime booted. The shell below is static HTML and the behaviour
// is plain TS, so nothing React-shaped ships to the browser.
//
// The index is fetched from /search.json on first open rather than bundled —
// it used to be `import`ed, which inlined every post body into the JS every
// visitor downloaded.
import { titleify } from "@/lib/utils/textConverter";

// Every entry is in the `blog` group today; the label is resolved at build
// time so the browser never needs the text-casing helpers.
const groupLabel = titleify("blog");
---

<div id="searchModal" class="search-modal" aria-hidden="true" data-search-modal>
  <div id="searchModalOverlay" class="search-modal-overlay" data-search-close>
  </div>
  <div
    class="search-wrapper"
    role="dialog"
    aria-modal="true"
    aria-label="사이트 검색"
    data-search-dialog
    data-group-label={groupLabel}
  >
    <div class="search-wrapper-header">
      <label for="searchInput" class="absolute top-[calc(50%-7px)] left-7">
        <span class="sr-only">검색</span>
        <svg
          viewBox="0 0 512 512"
          height="18"
          width="18"
          class="-mt-0.5"
          aria-hidden="true"
          data-search-icon
        >
          <path
            fill="currentcolor"
            d="M416 208c0 45.9-14.9 88.3-40 122.7L502.6 457.4c12.5 12.5 12.5 32.8.0 45.3s-32.8 12.5-45.3.0L330.7 376c-34.4 25.2-76.8 40-122.7 40C93.1 416 0 322.9.0 208S93.1.0 208 0 416 93.1 416 208zM208 352a144 144 0 100-288 144 144 0 100 288z"
          ></path>
        </svg>
      </label>
      {/* Replaces the magnifier once there is a query. */}
      <button
        type="button"
        class="absolute top-[calc(50%-7px)] left-7 -m-2.5 hidden cursor-pointer p-2.5"
        aria-label="검색어 지우기"
        data-search-clear
      >
        <svg viewBox="0 0 512 512" height="18" width="18" aria-hidden="true">
          <path
            fill="currentcolor"
            d="M256 512A256 256 0 10256 0a256 256 0 100 512zM175 175c9.4-9.4 24.6-9.4 33.9.0l47 47 47-47c9.4-9.4 24.6-9.4 33.9.0s9.4 24.6.0 33.9l-47 47 47 47c9.4 9.4 9.4 24.6.0 33.9s-24.6 9.4-33.9.0l-47-47-47 47c-9.4 9.4-24.6 9.4-33.9.0s-9.4-24.6.0-33.9l47-47-47-47c-9.4-9.4-9.4-24.6.0-33.9z"
          ></path>
        </svg>
      </button>
      <input
        id="searchInput"
        placeholder="검색어를 입력하세요..."
        class="search-wrapper-header-input"
        type="search"
        name="search"
        autocomplete="off"
        aria-describedby="searchResultCount"
        data-search-input
      />
    </div>

    <div class="search-wrapper-body" data-search-body>
      <div class="py-8 text-center">검색어를 입력해주세요...</div>
    </div>

    <div class="search-wrapper-footer">
      <span class="flex items-center">
        <kbd>↑</kbd>
        <kbd>↓</kbd>
        이동
      </span>
      <span class="flex items-center">
        <kbd>Enter</kbd>
        선택
      </span>
      <span id="searchResultCount" role="status" data-search-count></span>
      <span>
        <kbd>ESC</kbd> 닫기
      </span>
    </div>
  </div>
</div>

<script>
  import escapeRegExp from "@/lib/utils/escapeRegExp";

  interface SearchItem {
    slug: string;
    title: string;
    description: string;
    categories: string[];
    tags: string[];
    excerpt: string;
  }

  /** What the open dialog exposes to the one document-level key handler. */
  interface SearchController {
    isOpen: () => boolean;
    close: () => void;
    open: () => void;
    move: (delta: number) => void;
    activate: () => boolean;
    trapTab: (event: KeyboardEvent) => void;
  }

  const FOCUSABLE =
    'a[href], button:not([disabled]), input, [tabindex]:not([tabindex="-1"])';
  const EXCERPT_CONTEXT = 80;

  const CATEGORY_ICON = `<svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M11 0H3a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2 2 2 0 0 0 2-2V4a2 2 0 0 0-2-2 2 2 0 0 0-2-2zm2 3a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1V3zM2 2a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V2z"/></svg>`;
  const TAG_ICON = `<svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 2v4.586l7 7L14.586 9l-7-7H3zM2 2a1 1 0 0 1 1-1h4.586a1 1 0 0 1 .707.293l7 7a1 1 0 0 1 0 1.414l-4.586 4.586a1 1 0 0 1-1.414 0l-7-7A1 1 0 0 1 2 6.586V2z"/><path d="M5.5 5a.5.5 0 1 1 0-1 .5.5 0 0 1 0 1zm0 1a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zM1 7.086a1 1 0 0 0 .293.707L8.75 15.25l-.043.043a1 1 0 0 1-1.414 0l-7-7A1 1 0 0 1 0 7.586V3a1 1 0 0 1 1-1v5.086z"/></svg>`;
  const EMPTY_ICON = `<svg class="mx-auto" width="42" height="42" viewBox="0 0 47 47" fill="none" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M7.10368 33.9625C9.90104 36.2184 13.2988 37.6547 16.9158 38.0692C21.6958 38.617 26.5063 37.3401 30.3853 34.4939C30.4731 34.6109 30.5668 34.7221 30.6721 34.8304L41.9815 46.1397C42.5323 46.6909 43.2795 47.0007 44.0587 47.001C44.838 47.0013 45.5854 46.692 46.1366 46.1412C46.6878 45.5904 46.9976 44.8432 46.9979 44.064C46.9981 43.2847 46.6888 42.5373 46.138 41.9861L34.8287 30.6767C34.7236 30.5704 34.6107 30.4752 34.4909 30.3859C37.3352 26.5046 38.6092 21.6924 38.0579 16.912C37.6355 13.2498 36.1657 9.81322 33.8586 6.9977L31.7805 9.09214C34.0157 11.9274 35.2487 15.4472 35.2487 19.0942C35.2487 21.2158 34.8308 23.3167 34.0189 25.2769C33.207 27.2371 32.0169 29.0181 30.5167 30.5184C29.0164 32.0186 27.2354 33.2087 25.2752 34.0206C23.315 34.8325 21.2141 35.2504 19.0925 35.2504C16.9708 35.2504 14.8699 34.8325 12.9098 34.0206C11.5762 33.4682 10.3256 32.7409 9.18992 31.8599L7.10368 33.9625ZM28.9344 6.28152C26.1272 4.12516 22.671 2.93792 19.0925 2.93792C14.8076 2.93792 10.6982 4.64009 7.66829 7.66997C4.6384 10.6999 2.93623 14.8093 2.93623 19.0942C2.93623 21.2158 3.35413 23.3167 4.16605 25.2769C4.72475 26.6257 5.4625 27.8897 6.35716 29.0358L4.2702 31.1391C1.35261 27.548 -0.165546 23.0135 0.00974294 18.3781C0.19158 13.5695 2.18233 9.00695 5.58371 5.60313C8.98509 2.19932 13.5463 0.205307 18.3547 0.0200301C22.9447 -0.156832 27.4369 1.32691 31.0132 4.18636L28.9344 6.28152Z" fill="currentColor"/><path d="M3.13672 39.1367L38.3537 3.64355" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>`;

  const HTML_ESCAPES: Record<string, string> = {
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#39;",
  };

  const escapeHtml = (value: string) =>
    value.replace(/[&<>"']/g, (char) => HTML_ESCAPES[char]!);

  /** Site-root-relative URL, honouring a configured base path. */
  const withBase = (path: string) =>
    `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${path.replace(/^\//, "")}`;

  /**
   * Escapes `text`, then wraps each occurrence of `query`. Splitting on a
   * capturing group keeps the delimiters so non-matching pieces survive.
   * `query` is escaped before reaching the RegExp — typing "(" used to throw.
   */
  const mark = (text: string, query: string, tag: "mark" | "span") => {
    if (!query) return escapeHtml(text);
    return text
      .split(new RegExp(`(${escapeRegExp(query)})`, "gi"))
      .map((part) => {
        const escaped = escapeHtml(part);
        if (part.toLowerCase() !== query.toLowerCase()) return escaped;
        return tag === "mark"
          ? `<mark>${escaped}</mark>`
          : `<span class="underline">${escaped}</span>`;
      })
      .join("");
  };

  /** A window of the excerpt around the first hit, with the hit highlighted. */
  const matchExcerpt = (excerpt: string, query: string) => {
    const position = excerpt.toLowerCase().indexOf(query.toLowerCase());
    if (position === -1) return "";

    // Back up to the start of the word so the snippet does not begin mid-token.
    let wordStart = position;
    while (wordStart > 0 && excerpt[wordStart - 1] !== " ") wordStart--;

    const end = position + query.length;
    return (
      mark(excerpt.slice(wordStart, end), query, "mark") +
      escapeHtml(excerpt.slice(end, end + EXCERPT_CONTEXT))
    );
  };

  const taxonomyRow = (icon: string, values: string[], query: string) =>
    values.length
      ? `<div class="mr-2">${icon}${values
          .map((value) => mark(value, query, "span"))
          .join(", ")}</div>`
      : "";

  // The dialog lives inside the swapped document, so it is rebuilt on every
  // navigation. The document-level key handler below is registered once and
  // reads whichever controller is current.
  let controller: SearchController | null = null;

  function initSearch() {
    const modal = document.querySelector<HTMLElement>("[data-search-modal]");
    const dialog = modal?.querySelector<HTMLElement>("[data-search-dialog]");
    const input = modal?.querySelector<HTMLInputElement>("[data-search-input]");
    const body = modal?.querySelector<HTMLElement>("[data-search-body]");
    const count = modal?.querySelector<HTMLElement>("[data-search-count]");
    const clear = modal?.querySelector<HTMLElement>("[data-search-clear]");
    const icon = modal?.querySelector<HTMLElement>("[data-search-icon]");

    if (!modal || !dialog || !input || !body || !count || !clear) {
      controller = null;
      return;
    }

    const groupLabel = dialog.dataset.groupLabel ?? "";

    let index: SearchItem[] | null = null;
    let indexPromise: Promise<SearchItem[]> | null = null;
    let results: SearchItem[] = [];
    let selected = -1;
    let lastFocused: HTMLElement | null = null;

    // Fetched at most once per page load, then held in memory. It used to be
    // bundled into the JS, so every visitor downloaded every post body.
    const loadIndex = () => {
      indexPromise ??= fetch(withBase("search.json"))
        .then((response) => {
          if (!response.ok) throw new Error(String(response.status));
          return response.json() as Promise<SearchItem[]>;
        })
        .catch(() => []);
      return indexPromise;
    };

    const renderItem = (item: SearchItem, position: number, query: string) => {
      const excerpt = matchExcerpt(item.excerpt, query);
      return `<div class="search-result-item" data-search-index="${position}">
        <div class="search-result-item-body">
          <a href="${escapeHtml(withBase(item.slug))}" class="search-result-item-title search-result-item-link">${mark(item.title, query, "span")}</a>
          ${item.description ? `<p class="search-result-item-description">${mark(item.description, query, "span")}</p>` : ""}
          ${excerpt ? `<p class="search-result-item-content">${excerpt}</p>` : ""}
          <div class="search-result-item-taxonomies">${taxonomyRow(CATEGORY_ICON, item.categories, query)}${taxonomyRow(TAG_ICON, item.tags, query)}</div>
        </div>
      </div>`;
    };

    const render = () => {
      const query = input.value.trim();

      clear.classList.toggle("hidden", !query);
      icon?.classList.toggle("hidden", Boolean(query));

      if (!query) {
        results = [];
        count.textContent = "";
        body.innerHTML =
          '<div class="py-8 text-center">검색어를 입력해주세요...</div>';
        return;
      }

      if (!index) {
        count.textContent = "";
        body.innerHTML = '<div class="py-8 text-center">검색 중…</div>';
        return;
      }

      const regex = new RegExp(escapeRegExp(query), "i");
      results = index.filter((item) =>
        regex.test(
          [
            item.title,
            item.description,
            item.categories.join(" "),
            item.tags.join(" "),
            item.excerpt,
          ].join(" "),
        ),
      );

      count.textContent = `결과 ${results.length}개`;

      body.innerHTML = results.length
        ? `<div class="search-result"><div class="search-result-group"><p class="search-result-group-title">${escapeHtml(groupLabel)}</p>${results
            .map((item, position) => renderItem(item, position, query))
            .join("")}</div></div>`
        : `<div class="search-result"><div class="search-result-empty">${EMPTY_ICON}<p class="mt-4">&quot;<strong>${escapeHtml(query)}</strong>&quot;에 대한 검색 결과가 없습니다</p></div></div>`;
    };

    const select = (next: number) => {
      selected = next;
      body
        .querySelectorAll("[data-search-index]")
        .forEach((element, position) =>
          element.classList.toggle(
            "search-result-item-active",
            position === selected,
          ),
        );
      body
        .querySelector(`[data-search-index="${selected}"]`)
        ?.scrollIntoView({ behavior: "smooth", block: "nearest" });
    };

    const isOpen = () => modal.classList.contains("show");

    const open = () => {
      if (isOpen()) return;
      lastFocused = document.activeElement as HTMLElement | null;
      modal.classList.add("show");
      modal.setAttribute("aria-hidden", "false");
      input.focus();
      render();

      if (!index) {
        void loadIndex().then((loaded) => {
          index = loaded;
          if (isOpen()) render();
        });
      }
    };

    const close = () => {
      modal.classList.remove("show");
      modal.setAttribute("aria-hidden", "true");
      lastFocused?.focus();
    };

    const reset = () => {
      selected = -1;
      render();
    };

    document
      .querySelectorAll<HTMLElement>("[data-search-trigger]")
      .forEach((trigger) => trigger.addEventListener("click", open));

    modal
      .querySelectorAll<HTMLElement>("[data-search-close]")
      .forEach((element) => element.addEventListener("click", close));

    clear.addEventListener("click", () => {
      input.value = "";
      input.focus();
      reset();
    });

    input.addEventListener("input", reset);

    controller = {
      isOpen,
      close,
      open,
      move: (delta) => {
        if (results.length === 0) return;
        select(Math.min(Math.max(selected + delta, 0), results.length - 1));
      },
      activate: () => {
        const item = selected >= 0 ? results[selected] : undefined;
        if (!item) return false;
        window.location.href = withBase(item.slug);
        return true;
      },
      trapTab: (event) => {
        const focusable = Array.from(
          dialog.querySelectorAll<HTMLElement>(FOCUSABLE),
        ).filter((element) => element.offsetParent !== null);
        if (focusable.length === 0) return;

        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      },
    };
  }

  // Registered once for the lifetime of the tab. Binding this per navigation
  // is what previously stacked duplicate listeners.
  document.addEventListener("keydown", (event) => {
    if (!controller) return;

    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      controller.open();
      return;
    }

    // Everything below is scoped to the open dialog. Handling arrows
    // unconditionally used to preventDefault() page scrolling site-wide.
    if (!controller.isOpen()) return;

    switch (event.key) {
      case "Escape":
        controller.close();
        break;
      case "ArrowDown":
        event.preventDefault();
        controller.move(1);
        break;
      case "ArrowUp":
        event.preventDefault();
        controller.move(-1);
        break;
      case "Enter":
        if (controller.activate()) event.preventDefault();
        break;
      case "Tab":
        controller.trapTab(event);
        break;
    }
  });

  // Covers the first load and every ClientRouter navigation.
  document.addEventListener("astro:page-load", initSearch);
</script>
