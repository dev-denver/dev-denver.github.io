---
import BlogCard from "@/components/BlogCard.astro";

interface Props {
  posts: any[];
}

const { posts }: Props = Astro.props;
const isSparse = posts.length <= 2;
---

<h2 class="sr-only">게시글 목록</h2>
<div class={`row ${isSparse ? "justify-center" : ""}`}>
  {
    posts.map((post) => (
      <div
        class={
          isSparse
            ? "mb-14 mx-auto md:col-8 lg:col-6"
            : "mb-14 md:col-6 lg:col-4"
        }
      >
        <BlogCard data={post} />
      </div>
    ))
  }
</div>
