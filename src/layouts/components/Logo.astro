---
import config from "@/config/config.json";

// Text-only brand. The template shipped an image-logo branch driven by
// `site.logo` / `site.logo_darkmode`, but both were always empty and no caller
// ever passed an override, so it never rendered.
const { logo_text, title }: { logo_text: string; title: string } = config.site;
---

<a href="/" class="navbar-brand inline-block">{logo_text || title}</a>
