{
  "name": "dev-denver.github.io",
  "version": "0.0.1",
  "description": "Denver's dev blog",
  "author": "denver",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node scripts/themeGenerator.js --watch\" \"node scripts/jsonGenerator.js && astro dev\"",
    "build": "node scripts/themeGenerator.js && node scripts/jsonGenerator.js && astro build && node scripts/llmsGenerator.js",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier -w ./src",
    "format:check": "prettier -c ./src",
    "generate-json": "node scripts/jsonGenerator.js",
    "generate-llms": "node scripts/llmsGenerator.js",
    "remove-darkmode": "node scripts/removeDarkmode.js && npm run format"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/mdx": "^7.0.7",
    "@astrojs/react": "6.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@digi4care/astro-google-tagmanager": "^2.0.0",
    "@justinribeiro/lite-youtube": "^1.9.0",
    "astro": "^7.2.4",
    "astro-auto-import": "^0.5.2",
    "date-fns": "^4.4.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.3",
    "vite": "^8.1.5"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "concurrently": "^10.0.4",
    "glob": "^13.0.6",
    "node-html-parser": "^9.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwind-bootstrap-grid": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "typescript": "$typescript",
    "astro": "$astro"
  }
}
